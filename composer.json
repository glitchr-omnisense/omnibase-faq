{
    "name": "omnibase/faq",
    "description": "A FAQ for omnibase: questions by section, answered in the back office, and the form to ask another.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": "^8.2",
        "doctrine/doctrine-bundle": "^2.10|^3.0",
        "doctrine/orm": "^2.15|^3.0",
        "omnibridge/symfony": "^1.1 || ^2.0",
        "omnisense/omnibase": "^5.1 || ^6.0",
        "omnibase/admin": "^1.0",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {"psr-4": {"Base\\Faq\\": "./src"}},
    "autoload-dev": {"psr-4": {"Base\\Faq\\Tests\\": "./tests"}},
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "omnibridge/composer": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "prefer-stable": true
}
