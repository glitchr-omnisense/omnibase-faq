<div class="analytics-card card faq-pending">
    <div class="analytics-card-header"><h2 class="analytics-card-title">{{ widget.label|trans({}, 'admin') }}</h2></div>
    <div class="faq-pending-body">
        <a class="faq-pending-count{{ pending > 0 ? ' is-waiting' }}" href="{{ path('admin_crud_questions_index', {filters: {state: 'STATE_DRAFT'}}) }}">
            <strong>{{ pending }}</strong><span>{{ '@faq.admin.widget.pending'|trans({count: pending}) }}</span>
        </a>
        {% if questions %}
        <ul class="faq-pending-list">{% for question in questions %}<li><a href="{{ path('admin_crud_questions_edit', {entityId: question.id}) }}">{{ question.title }}</a></li>{% endfor %}</ul>
        {% else %}<p class="faq-pending-empty">{{ '@faq.admin.widget.none'|trans }}</p>{% endif %}
    </div>
</div>
<style>
    .faq-pending-body { display: grid; gap: .75rem; padding: 0 1rem 1rem; }
    .faq-pending-count { display: grid; gap: .2rem; padding: .9rem 1rem; border-radius: .75rem; background: rgba(127,127,127,.08); color: inherit; text-decoration: none; }
    .faq-pending-count strong { font-size: 1.6rem; line-height: 1.1; }
    .faq-pending-count span { font-size: .8rem; opacity: .75; }
    .faq-pending-count.is-waiting { background: rgba(252,104,117,.16); }
    .faq-pending-count.is-waiting strong { color: #d9404e; }
    .faq-pending-list { margin: 0; padding: 0; list-style: none; display: grid; gap: .4rem; font-size: .85rem; }
    .faq-pending-list a { color: inherit; text-decoration: none; }
    .faq-pending-empty { margin: 0; font-size: .85rem; opacity: .7; }
</style>
